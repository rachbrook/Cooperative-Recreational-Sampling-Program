title: "2022-2024 Cooperative Summary"
author: "Rachel Brooks"
format: html
editor: visual
---


## Import packages and clean-up data


```{r}

library(modelsummary)
library(tidyverse)
library(data.table)
library(ggplot2)
library(readxl)
library(dplyr)
library(googlesheets4)

coop <- read_sheet("https://docs.google.com/spreadsheets/d/1_ydIN0FOKdNB5z35uV0qqcNfAGHdt1HGheUmDc5B1LI/edit?gid=1569662549#gid=1569662549", sheet = "Merged Data")

# Clean-up weird 'Capture_Date' formatting
coop$Capture_Date <- sapply(coop$Capture_Date, function(x) {
  if (length(x) == 0) {
    NA_character_
  } else if (is.character(x)) {
    # Convert m/d/yyyy to ISO yyyy-mm-dd string
    as.character(as.Date(x, format = "%m/%d/%Y"))
  } else if (is.numeric(x)) {
    # Convert Excel serial to ISO yyyy-mm-dd string
    as.character(as.Date(x, origin = "1899-12-30"))
  } else {
    NA_character_
  }
})

# Filter out rows where there is no capture date 
# (filters out 15 samples as of 8/11/2025)
coop <- coop[!is.na(coop$Capture_Date), ]



```


## Assign vessels to CRFS districts and add species common names


```{r, warning = FALSE, message = FALSE, echo = FALSE}

unique_vessels <- unique(coop$Vessel)
print(unique_vessels)

coop <- coop %>%
  mutate(CRFS_District = case_when(

#District 1 - South
Vessel %in% c("Betty-O","New Del Mar","Eldorado","Amigo","(Newport) Patriot","Western Pride","Thunderbird","Fury","Sum Fun","Outer Limits","Premier" ) ~ "District 1 - South",
# District 2 - Channel  
Vessel %in% c("Endeavor","Island Spirit","Coral Sea","Stardust","Mirage") ~ "District 2 - Channel",
# District 3 - Central    
Vessel %in% c("Infinity","Legacy","Big Anchovy","Kahuna","Last Meal","The Marianne","Black Pearl","Fiesta","(Avila) Patriot") ~ "District 3 - Central",  
# District 4 - San Francisco    
Vessel %in% c("Dragonfly","Big Eye","New Sea Angler","Salty Lady","Lovely Martha","Sea Wolf","Queen of Hearts","New Captain Pete","Riptide") ~ "District 4 - San Francisco",
# District 5 - Wine   
Vessel %in% c("Sea Hawk","Saylor Ann","Kyndall Lynn","Telstar") ~ "District 5 - Wine",
# District 6 - Redwood    
Vessel %in% c("Onyx","Out Of The Box","New Reel Steel","Scrimshaw","Fishy Business") ~ "District 6 - Redwood",  # Changed from `==` to `%in%`
TRUE ~ "Unknown"  # Default for unmatched names
  ))

#Import PacFIN Species Table
PacFIN_Codes <- read_excel("PacFIN_Codes.xlsx")
coop <- merge(coop, PacFIN_Codes, by = "PacFIN_Species_Code", all.x = TRUE)  # Left join

coop <- coop %>%
  filter(!is.na(PacFIN_Species_Code))

coop$Species_Name <- recode_factor(coop$Species_Name,
                                      'Blue Rockfish' = "Blue/Deacon Rockfish",
                                      'Deacon Rockfish' = "Blue/Deacon Rockfish")

#write.csv(Coop_Data, "coop-data.csv", row.names = FALSE)
```


## Summary of Cooperative Data - OVERALL


```{r, fig.width=15, fig.height=10, out.width="80%"}

datasummary_crosstab(CRFS_District ~ Year, statistic = 1 ~ N, title = 'Table 1: Summary of groundfish sampled in 2022-2025', data = coop)

datasummary_crosstab(Species_Name ~ Year,statistic = 1 ~ N, title = 'Table 1: Summary of species sampled in 2022-2025', data = coop)


# Calculate the abundance of each species
Abundance_Coastwide <- Coop_Data %>%
  group_by(Species_Name) %>%
  summarise(Abundance = n()) %>%
  arrange(desc(Abundance)) %>%
  top_n(12, Abundance)  # Get the top 10 most abundant species

# Filter the dataset to include only top 10 species
top_12_coastwide <- Coop_Data %>%
  filter(Species_Name %in% Abundance_Coastwide$Species_Name)

# Density plot
ggplot(top_12_coastwide, aes(x = Fork_Length_mm, fill = Sex)) +
 geom_histogram(aes(y = ..count..), bins = 20, alpha = 1, position = "identity", color = "black") +  # Histogram with density on y-axis
  geom_density(alpha = 0.6, color = "black") +  # Kernel density plot overlaid
  facet_wrap(~Species_Name) +  # Create separate panels for each species
  labs(title = "",
       x = "Fork Length (mm)",
       y = "Count") +
  theme_minimal() +
  scale_fill_manual(values = c("tomato", "dodgerblue", "grey")) +
  theme(
    panel.grid = element_blank(),  # Remove grid lines
    axis.title = element_text(size = 22),  # Adjust axis title size
    axis.text = element_text(size = 22),   # Adjust axis label text size
    plot.title = element_text(size = 22),  # Adjust plot title size
    strip.text = element_text(size = 22),   # Adjust facet label size
    legend.title = element_text(size = 22), # Increase legend title size
    legend.text = element_text(size = 22),  # Increase legend text size
    legend.key.size = unit(1, "cm")      # Increase the size of the legend keys
  )





```


## District 6 - Redwood

Includes F/V Onyx, F/V Out OF The Box, F/V New Reel Steel, F/V Scrimshaw


```{r, fig.width=12, fig.height=10, out.width="80%", fig.cap="Length Frequency Distribution of Top 6 Most Abundant Species in Distrct 6 - Redwood"}

D6 <- Coop_Data %>%
  filter(CRFS_District == "District 6 - Redwood")
datasummary_crosstab(Species_Name ~ Year, 
          statistic = 1 ~ N, 
          title = "Table 7: Summary of species sampled 2022-2024 for District 6 - Redwood", data = D6)

# Calculate the abundance of each species
Abundance_D6 <- D6 %>%
  filter(Year == "2024") %>%
  group_by(Species_Name) %>%
  summarise(Abundance = n()) %>%
  arrange(desc(Abundance)) %>%
  top_n(6, Abundance)  # Get the top 10 most abundant species

# Filter the dataset to include only top 10 species
top_6_species_D6 <- D6 %>%
  filter(Species_Name %in% Abundance_D6$Species_Name)

# Density plot
ggplot(top_6_species_D6, aes(x = Fork_Length_mm, fill = Sex)) +
geom_histogram(aes(y = ..count..), bins = 20, alpha = 1, position = "identity", color = "black") +  # Histogram with density on y-axis
  geom_density(alpha = 0.6, color = "black") +  # Kernel density plot overlaid
  facet_wrap(~Species_Name) +  # Create separate panels for each species
  labs(title = "",
       x = "Fork Length (mm)",
       y = "Count") +
  theme_minimal() +
  scale_fill_manual(values = c("tomato", "dodgerblue", "grey")) +
  theme(
    panel.grid = element_blank(),  # Remove grid lines
    axis.title = element_text(size = 22),  # Adjust axis title size
    axis.text = element_text(size = 22),   # Adjust axis label text size
    plot.title = element_text(size = 22),  # Adjust plot title size
    strip.text = element_text(size = 22),   # Adjust facet label size
    legend.title = element_text(size = 22), # Increase legend title size
    legend.text = element_text(size = 22),  # Increase legend text size
    legend.key.size = unit(1, "cm")      # Increase the size of the legend keys
  )

